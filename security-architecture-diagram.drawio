<mxfile host="app.diagrams.net" pages="1">
  <diagram name="Security Architecture" id="sec-arch-final">
    <mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Secure Agentic App — VPC Security Architecture (Final)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Multi-Region | VPC Isolated | JWT + WAF + Cedar Policy | ARC Failover" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="400" y="15" width="700" height="50" as="geometry" />
        </mxCell>

        <!-- Internet Zone -->
        <mxCell id="internet" value="&lt;b&gt;Internet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="1700" height="100" as="geometry" />
        </mxCell>
        <mxCell id="user" value="👤 User Browser&lt;br&gt;MSAL + JWT" style="shape=mxgraph.aws4.client;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="azure" value="🔐 Azure Entra ID&lt;br&gt;OAuth2 + JWKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1550" y="100" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- Edge Layer -->
        <mxCell id="edge" value="&lt;b&gt;Edge Layer (Global)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="700" height="110" as="geometry" />
        </mxCell>
        <mxCell id="waf" value="🛡️ WAF&lt;br&gt;IP Rep + SQLi&lt;br&gt;Rate: 2000/5min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="80" y="230" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cloudfront" value="📡 CloudFront&lt;br&gt;HTTPS + OAC&lt;br&gt;TLS 1.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="240" y="230" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="📦 S3 Frontend&lt;br&gt;Private (OAC)&lt;br&gt;Encrypted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="400" y="230" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lambdaedge" value="⚡ Lambda@Edge&lt;br&gt;ARC Origin Router&lt;br&gt;(failover logic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="560" y="230" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- ARC -->
        <mxCell id="arc" value="🔄 ARC&lt;br&gt;Route53 Recovery&lt;br&gt;On = Primary&lt;br&gt;Off = DR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="800" y="230" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- Primary Region VPC -->
        <mxCell id="primary" value="&lt;b&gt;🟢 us-east-1 (Primary) — VPC 10.0.0.0/16&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="340" width="850" height="520" as="geometry" />
        </mxCell>

        <!-- Private Subnets -->
        <mxCell id="private1" value="&lt;b&gt;Private Subnets (use1-az4 + use1-az1) — No Internet Gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="380" width="550" height="450" as="geometry" />
        </mxCell>

        <!-- API Gateway + JWT -->
        <mxCell id="httpapi" value="🔒 HTTP API Gateway&lt;br&gt;&lt;b&gt;JWT Authorizer&lt;/b&gt;&lt;br&gt;(Azure AD tokens)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="100" y="420" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Lambda Functions -->
        <mxCell id="agentproxy" value="λ Agent Proxy&lt;br&gt;(VPC attached)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="100" y="510" width="120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="🤖 AgentCore Runtime&lt;br&gt;&lt;b&gt;VPC Mode&lt;/b&gt;&lt;br&gt;(Strands + Claude 4.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="100" y="585" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="oauthcb" value="λ OAuth Callback&lt;br&gt;(scoped IAM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="300" y="510" width="120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="orderslambdas" value="λ Orders Lambdas&lt;br&gt;GET / POST / PUT&lt;br&gt;(VPC attached)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="300" y="585" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="authorizer" value="λ JWT Authorizer&lt;br&gt;(Azure AD JWKS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="460" y="585" width="120" height="55" as="geometry" />
        </mxCell>

        <!-- Security Groups box -->
        <mxCell id="sgbox" value="🔒 &lt;b&gt;Security Groups&lt;/b&gt;&lt;br&gt;Lambda SG: egress 443 → Endpoints + NAT&lt;br&gt;Endpoint SG: ingress 443 from Lambda SG only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="670" width="320" height="55" as="geometry" />
        </mxCell>

        <!-- NAT Gateway -->
        <mxCell id="nat1" value="🌐 NAT GW&lt;br&gt;(Azure AD only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="100" y="750" width="110" height="40" as="geometry" />
        </mxCell>

        <!-- VPC Endpoints -->
        <mxCell id="endpoints1" value="&lt;b&gt;VPC Endpoints (11 — PrivateLink)&lt;/b&gt;&lt;br&gt;&lt;br&gt;🆓 DynamoDB (Gateway)&lt;br&gt;🆓 S3 (Gateway)&lt;br&gt;━━━━━━━━━━━━━━━&lt;br&gt;SecretsManager&lt;br&gt;Bedrock Runtime (LLM)&lt;br&gt;CloudWatch Logs&lt;br&gt;ECR Docker + API&lt;br&gt;bedrock-agentcore&lt;br&gt;bedrock-agentcore.gateway&lt;br&gt;bedrock-agent-runtime&lt;br&gt;execute-api (DNS off)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="380" width="220" height="240" as="geometry" />
        </mxCell>

        <!-- Orders API (outside VPC but in region) -->
        <mxCell id="ordersapi1" value="🛡️ Orders REST API&lt;br&gt;&lt;b&gt;REGIONAL + JWT + WAF&lt;/b&gt;&lt;br&gt;(IP rep + SQLi + Rate limit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="650" y="650" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- AgentCore Gateway (AWS managed, external) -->
        <mxCell id="gateway1" value="🔗 AgentCore Gateway&lt;br&gt;&lt;b&gt;AWS-Managed (External)&lt;/b&gt;&lt;br&gt;MCP + JWT Auth&lt;br&gt;Cedar Policy Engine&lt;br&gt;(qty &gt;= 100 blocked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="650" y="735" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- DynamoDB -->
        <mxCell id="ddb" value="📊 DynamoDB&lt;br&gt;&lt;b&gt;Global Table&lt;/b&gt;&lt;br&gt;us-east-1 ↔ us-east-2&lt;br&gt;(via Gateway Endpoint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="450" y="670" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- DR Region (simplified) -->
        <mxCell id="dr" value="&lt;b&gt;🟡 us-east-2 (DR) — VPC 10.1.0.0/16&lt;/b&gt;&lt;br&gt;&lt;br&gt;Identical security posture:&lt;br&gt;• 11 VPC Endpoints ✅&lt;br&gt;• All Lambdas in VPC ✅&lt;br&gt;• Runtime VPC Mode ✅&lt;br&gt;• JWT Authorizer ✅&lt;br&gt;• WAF on Orders API ✅&lt;br&gt;• Cedar Policy Engine ✅&lt;br&gt;• CORS restricted ✅&lt;br&gt;&lt;br&gt;&lt;i&gt;Activated when ARC = Off&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontSize=10;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="950" y="340" width="250" height="250" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;🟢 Green border = VPC isolated&lt;br&gt;🔴 Red border = Auth enforced&lt;br&gt;🟠 Orange border = VPC Endpoints&lt;br&gt;🟣 Purple = AWS-managed service&lt;br&gt;🟡 Yellow = NAT / External path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1250" y="340" width="200" height="120" as="geometry" />
        </mxCell>

        <!-- Key Stats -->
        <mxCell id="stats" value="&lt;b&gt;Security Stats&lt;/b&gt;&lt;br&gt;• 6 Lambdas in VPC per region&lt;br&gt;• 11 VPC Endpoints per region&lt;br&gt;• 2 WAF WebACLs (API + CF)&lt;br&gt;• JWT on all API routes&lt;br&gt;• 0 public endpoints for compute&lt;br&gt;• &lt; 30s failover via ARC&lt;br&gt;• DynamoDB Global Table (RPO=0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1250" y="490" width="200" height="140" as="geometry" />
        </mxCell>

